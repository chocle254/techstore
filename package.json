{
  "name": "jonwin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev --webpack",
    "build": "node node_modules/next/dist/bin/next build --webpack",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "db:generate": "node node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node node_modules/tsx/dist/cli.mjs scripts/migrate.mts",
    "db:seed": "node node_modules/tsx/dist/cli.mjs scripts/seed.mts",
    "create-boss": "node node_modules/tsx/dist/cli.mjs scripts/create-boss.mts",
    "setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@neondatabase/serverless": "^1.2.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "@vercel/blob": "^2.8.2",
    "drizzle-orm": "^0.45.4",
    "leaflet": "^1.9.4",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
