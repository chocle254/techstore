# Copy to .env.local for local development. Everything is optional locally.

# Postgres. Set automatically on Vercel when you add Neon. Leave empty locally to use the embedded database.
DATABASE_URL=

# The site's public address, used in password reset emails.
NEXT_PUBLIC_SITE_URL=https://jonwin-clean.vercel.app

# Password reset emails (https://resend.com). Without a key, emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM="JonWin Clean <no-reply@your-domain>"

# Rate limiting across servers. Set automatically when you add Upstash Redis on Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=
